# ==========================================
# PLANORA ENVIRONMENT CONFIGURATION (SAMPLE)
# Copy this file to backend/.env and fill in your values
# ==========================================

FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Database Configuration (MySQL recommended; SQLite supported as local fallback)
# For MySQL:
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/planora
# For SQLite local fallback:
# DATABASE_URL=sqlite:///instance/planora.db

# JWT Secret Key for token signing (generate a random 32+ character string)
JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_key_2025

# AI Provider Configuration ('gemini' or 'openai')
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI API Key (optional alternative)
OPENAI_API_KEY=

# Storage folder for PDF study materials & question images
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
