# ==========================================
# PLANORA BACKEND CONFIGURATION
# ==========================================

FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Database Configuration (MySQL recommended; SQLite supported as local fallback)
# For MySQL:
DATABASE_URL=mysql+pymysql://root:password@localhost/planora
# For SQLite local fallback when MySQL is not running:
# DATABASE_URL=sqlite:///planora.db

# JWT Secret Key for token signing
JWT_SECRET_KEY=change_this_super_secret_jwt_key_planora_2025

# AI Provider Configuration ('gemini' or 'openai')
AI_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=

# OpenAI API Key (optional alternative)
OPENAI_API_KEY=

# Storage folder for PDF study materials & question images
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
